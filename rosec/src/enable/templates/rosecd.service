[Unit]
Description=rosec - multi-provider Secret Service daemon
Documentation=https://github.com/jmylchreest/rosec
After=dbus.service
Requires=dbus.service

# Not ordered after graphical-session.target: pam_rosec's PAM-session helper
# fires before the compositor is up, and logind autolock runs on the system bus.

[Service]
Type=dbus
BusName=org.freedesktop.secrets
ExecStart=@@ROSECD@@
Restart=on-failure
RestartSec=5

# Security hardening.
#
# The SSH agent exposes a FUSE filesystem at $XDG_RUNTIME_DIR/rosec/ssh/ that
# must be visible in the user's session mount namespace.  Any systemd directive
# that implies a private mount namespace (ProtectSystem, PrivateTmp,
# ProtectKernelTunables, ProtectKernelModules, ProtectControlGroups) would make
# the FUSE mount invisible outside the service, so they are intentionally
# omitted.
#
# NoNewPrivileges is omitted because fusermount3's setuid bit is required.
#   IMPORTANT: Many directives implicitly enable NoNewPrivileges — including
#   RestrictRealtime, SystemCallFilter, SystemCallArchitectures,
#   RestrictAddressFamilies, RestrictNamespaces, PrivateDevices, ProtectClock,
#   ProtectKernelTunables, ProtectKernelModules, ProtectKernelLogs,
#   MemoryDenyWriteExecute, RestrictSUIDSGID, LockPersonality, and
#   PrivateUsers.  None of these may be used here.
#
# MemoryDenyWriteExecute is omitted because wasmtime's JIT needs W+X pages.
# RestrictNamespaces is omitted because fusermount3 may use mount namespaces.
#
# DeviceAllow is omitted because /dev/fuse is world-accessible (crw-rw-rw-)
# and the device cgroup filter it installs can block fusermount3 in user
# service units even when the device path is explicitly allowed.
#
# RestrictRealtime is omitted because it implicitly sets NoNewPrivileges=yes.
#
# Allow mlockall so decrypted secrets are never swapped to disk.
LimitMEMLOCK=infinity
PrivateNetwork=no
Environment=RUST_LOG=info

[Install]
WantedBy=default.target
Also=rosecd.socket
